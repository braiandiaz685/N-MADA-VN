*(Nota: Si algún juego no tiene versión para PC o Android, o no tenés enlace para alguna plataforma, simplemente dejá las comillas vacías `""` y el botón se ocultará automáticamente).*

---

### 2. Actualizá tu archivo `index.html`

```html
<!DOCTYPE html>
<html lang="es" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NexusVault - Visual Novels & Games Hub</title>
    <script src="[https://cdn.tailwindcss.com](https://cdn.tailwindcss.com)"></script>
    <link href="[https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap](https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap)" rel="stylesheet">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        darkBg: '#080C14',
                        cardBg: 'rgba(18, 24, 38, 0.7)',
                        accentPurple: '#7c3aed',
                        accentPink: '#db2777'
                    },
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        body { background-color: #080C14; color: #f3f4f6; font-family: 'Plus Jakarta Sans', sans-serif; }
        .glass { background: rgba(18, 24, 38, 0.65); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.08); }
        .glass-hover:hover { background: rgba(26, 34, 52, 0.8); border-color: rgba(124, 58, 237, 0.4); }
        .glow { box-shadow: 0 0 40px -10px rgba(124, 58, 237, 0.3); }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="min-h-screen selection:bg-purple-600 selection:text-white pb-20 flex flex-col justify-between">

    <div>
        <!-- BARRA SUPERIOR -->
        <header class="sticky top-0 z-50 glass border-b border-white/5">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-purple-600 to-pink-600 flex items-center justify-center glow">
                        <span class="text-xl font-black">N</span>
                    </div>
                    <span class="text-xl font-bold bg-gradient-to-r from-white via-purple-200 to-purple-400 bg-clip-text text-transparent">NexusVault</span>
                </div>
                
                <div class="flex items-center space-x-4">
                    <input type="text" id="searchInput" placeholder="Buscar juegos o novelas..." class="bg-black/40 border border-white/10 rounded-full px-4 py-2 text-sm focus:outline-none focus:border-purple-500 w-40 sm:w-64 transition-all">
                    
                    <a href="AQUÍ_PEGA_TU_LINK_DE_DONACION" target="_blank" class="bg-pink-600/20 text-pink-300 border border-pink-500/30 hover:bg-pink-600 hover:text-white px-4 py-2 rounded-full text-xs font-bold transition-all flex items-center space-x-1.5">
                        <span>☕ Apoyar</span>
                    </a>

                    <span class="text-xs bg-red-500/20 text-red-400 border border-red-500/30 px-3 py-1 rounded-full font-semibold">+18</span>
                </div>
            </div>
        </header>

        <!-- BANNER DESTACADO -->
        <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8">
            <div class="relative rounded-3xl overflow-hidden glass p-8 sm:p-12 border border-white/10 flex flex-col justify-end min-h-[400px]">
                <div class="absolute inset-0 bg-gradient-to-t from-[#080C14] via-[#080C14]/60 to-transparent z-10"></div>
                <div class="absolute inset-0 bg-[url('[https://images.unsplash.com/photo-1542751371-adc38448a05e?q=80&w=1600](https://images.unsplash.com/photo-1542751371-adc38448a05e?q=80&w=1600)')] bg-cover bg-center opacity-40"></div>
                
                <div class="relative z-20 max-w-2xl">
                    <div class="flex items-center space-x-3 mb-2">
                        <span class="bg-purple-600/30 text-purple-300 border border-purple-500/30 text-xs px-3 py-1 rounded-full font-bold uppercase tracking-wider">Destacado del Mes</span>
                        <span class="text-xs font-semibold bg-white/10 px-2 py-1 rounded-md text-gray-200 border border-white/10">🖥️ PC</span>
                        <span class="text-xs font-semibold bg-white/10 px-2 py-1 rounded-md text-gray-200 border border-white/10">📱 Android</span>
                    </div>
                    
                    <h1 class="text-3xl sm:text-5xl font-extrabold mt-2 mb-3 tracking-tight">Cybernetic Dreams: Episode I</h1>
                    <p class="text-gray-300 text-sm sm:text-base mb-6 line-clamp-2">Una novela visual interactiva de ciencia ficción con múltiples finales y romance en una megaciudad futurista.</p>
                </div>
            </div>
        </section>

        <!-- CONTENIDO PRINCIPAL -->
        <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-12">
            <h2 class="text-xl font-bold mb-4 flex items-center space-x-2">
                <span class="w-2 h-2 rounded-full bg-purple-500"></span>
                <span>Últimos Lanzamientos y Categorías</span>
            </h2>

            <!-- BARRA DE CATEGORÍAS -->
            <div id="categoriasContainer" class="flex items-center space-x-2 overflow-x-auto no-scrollbar py-2 mb-8 border-y border-white/5">
                <button onclick="filtrarCategoria('todos')" class="bg-purple-600 text-white text-xs font-semibold px-4 py-2 rounded-full whitespace-nowrap transition-all shadow-md shadow-purple-600/20">Todos</button>
                <button onclick="filtrarCategoria('Acción')" class="glass glass-hover text-gray-300 text-xs font-semibold px-4 py-2 rounded-full whitespace-nowrap transition-all">Acción</button>
                <button onclick="filtrarCategoria('RPG')" class="glass glass-hover text-gray-300 text-xs font-semibold px-4 py-2 rounded-full whitespace-nowrap transition-all">RPG</button>
                <button onclick="filtrarCategoria('Simulación')" class="glass glass-hover text-gray-300 text-xs font-semibold px-4 py-2 rounded-full whitespace-nowrap transition-all">Simulación</button>
                <button onclick="filtrarCategoria('Metroidvania')" class="glass glass-hover text-gray-300 text-xs font-semibold px-4 py-2 rounded-full whitespace-nowrap transition-all">Metroidvania</button>
            </div>

            <!-- CONTENEDOR DE JUEGOS DINÁMICO -->
            <div id="juegosGrid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-6">
                <!-- Se cargan automáticamente desde juegos.json -->
            </div>

            <!-- MENSAJE SI NO HAY RESULTADOS -->
            <div id="noResults" class="hidden text-center py-16 text-gray-400">
                <p class="text-lg font-semibold">No se encontraron juegos con esa búsqueda.</p>
            </div>

            <!-- PAGINACIÓN -->
            <div id="paginacionContainer" class="flex justify-center items-center space-x-3 mt-12"></div>
        </main>
    </div>

    <!-- PIE DE PÁGINA -->
    <footer class="mt-20 glass border-t border-white/5 py-10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-6">
            <div class="flex items-center space-x-3">
                <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-purple-600 to-pink-600 flex items-center justify-center glow">
                    <span class="text-sm font-black text-white">N</span>
                </div>
                <span class="text-sm font-bold text-gray-300">NexusVault © 2026 - Todos los derechos reservados</span>
            </div>
        </div>
    </footer>

    <!-- VENTANA MODAL DE DESCARGA CON PC Y ANDROID -->
    <div id="downloadModal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-md hidden flex items-center justify-center p-4">
        <div class="glass max-w-xl w-full rounded-3xl p-6 sm:p-8 relative border border-white/10 shadow-2xl max-h-[90vh] overflow-y-auto">
            <button onclick="closeModal()" class="absolute top-6 right-6 text-gray-400 hover:text-white bg-white/5 hover:bg-white/10 p-2 rounded-full transition-all">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
            
            <h2 id="modalTitle" class="text-2xl font-bold mb-2">Título del Juego</h2>
            <div class="flex items-center space-x-3 mb-4">
                <span id="modalCategory" class="text-xs bg-purple-600/20 text-purple-300 border border-purple-500/30 px-2.5 py-0.5 rounded-full font-semibold">Categoría</span>
            </div>

            <div class="mb-6 bg-black/30 border border-white/5 p-4 rounded-2xl">
                <h3 class="text-xs font-bold text-purple-400 uppercase tracking-wider mb-2">Sinopsis</h3>
                <p id="modalDescription" class="text-sm text-gray-300 leading-relaxed">Descripción del juego...</p>
            </div>
            
            <div class="space-y-6">
                <!-- SECCIÓN PC -->
                <div id="seccionPc">
                    <h3 class="text-sm font-bold text-gray-200 mb-3">🖥️ Descargar para PC (Windows)</h3>
                    <div id="gridPc" class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                        <!-- Se llena dinámicamente -->
                    </div>
                </div>

                <!-- SECCIÓN ANDROID -->
                <div id="seccionAndroid" class="border-t border-white/10 pt-4">
                    <h3 class="text-sm font-bold text-gray-200 mb-3">📱 Descargar para Android (APK)</h3>
                    <div id="gridAndroid" class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                        <!-- Se llena dinámicamente -->
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- SCRIPT -->
    <script>
        let todosLosJuegos = [];
        let categoriaActual = 'todos';
        let busquedaActual = '';
        let paginaActual = 1;
        const juegosPorPagina = 8;

        fetch('juegos.json')
            .then(response => response.json())
            .then(data => {
                todosLosJuegos = data;
                renderizarJuegos();
            })
            .catch(error => console.error('Error al cargar juegos.json:', error));

        document.getElementById('searchInput').addEventListener('input', (e) => {
            busquedaActual = e.target.value.toLowerCase();
            paginaActual = 1;
            renderizarJuegos();
        });

        function filtrarCategoria(categoria) {
            categoriaActual = categoria;
            paginaActual = 1;
            renderizarJuegos();
        }

        function cambiarPagina(num) {
            paginaActual = num;
            renderizarJuegos();
            window.scrollTo({ top: 400, behavior: 'smooth' });
        }

        function renderizarJuegos() {
            const grid = document.getElementById('juegosGrid');
            const noResults = document.getElementById('noResults');
            const paginacionContainer = document.getElementById('paginacionContainer');
            
            grid.innerHTML = '';

            const juegosFiltrados = todosLosJuegos.filter(juego => {
                const coincideCategoria = categoriaActual === 'todos' || juego.categoria.toLowerCase() === categoriaActual.toLowerCase();
                const coincideBusqueda = juego.titulo.toLowerCase().includes(busquedaActual) || juego.categoria.toLowerCase().includes(busquedaActual);
                return coincideCategoria && coincideBusqueda;
            });

            if (juegosFiltrados.length === 0) {
                noResults.classList.remove('hidden');
                paginacionContainer.innerHTML = '';
                return;
            } else {
                noResults.classList.add('hidden');
            }

            const totalPaginas = Math.ceil(juegosFiltrados.length / juegosPorPagina);
            const inicio = (paginaActual - 1) * juegosPorPagina;
            const fin = inicio + juegosPorPagina;
            const juegosPagina = juegosFiltrados.slice(inicio, fin);

            juegosPagina.forEach(juego => {
                const card = document.createElement('div');
                card.className = "juego-card glass glass-hover rounded-2xl overflow-hidden cursor-pointer transition-all duration-300 group";
                card.onclick = () => openModal(juego);
                
                card.innerHTML = `
                    <div class="h-64 overflow-hidden relative">
                        <img src="${juego.imagen}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                    </div>
                    <div class="p-4">
                        <div class="flex items-center justify-between">
                            <span class="text-xs text-purple-400 font-semibold">${juego.categoria}</span>
                            <span class="text-xs text-gray-400 font-medium">🖥️ / 📱</span>
                        </div>
                        <h3 class="font-bold text-base mt-1 truncate">${juego.titulo}</h3>
                    </div>
                `;
                grid.appendChild(card);
            });

            paginacionContainer.innerHTML = '';
            if (totalPaginas > 1 && categoriaActual === 'todos' && busquedaActual === '') {
                for (let i = 1; i <= totalPaginas; i++) {
                    const btn = document.createElement('button');
                    btn.onclick = () => cambiarPagina(i);
                    btn.className = i === paginaActual 
                        ? "w-10 h-10 rounded-xl bg-purple-600 text-white font-bold flex items-center justify-center transition-all shadow-lg shadow-purple-600/30"
                        : "w-10 h-10 rounded-xl glass glass-hover text-gray-300 font-bold flex items-center justify-center transition-all";
                    btn.innerText = i;
                    paginacionContainer.appendChild(btn);
                }
            }
        }

        function openModal(juego) {
            document.getElementById('modalTitle').innerText = juego.titulo;
            document.getElementById('modalCategory').innerText = juego.categoria;
            document.getElementById('modalDescription').innerText = juego.descripcion || "Sin descripción disponible.";

            // Generar botones de PC
            const gridPc = document.getElementById('gridPc');
            const seccionPc = document.getElementById('seccionPc');
            gridPc.innerHTML = '';
            let tienePc = false;

            if (juego.pc) {
                if (juego.pc.mega) { gridPc.innerHTML += `<a href="${juego.pc.mega}" target="_blank" class="glass glass-hover p-2.5 rounded-xl text-center font-semibold text-sm text-purple-300">Mega</a>`; tienePc = true; }
                if (juego.pc.mediafire) { gridPc.innerHTML += `<a href="${juego.pc.mediafire}" target="_blank" class="glass glass-hover p-2.5 rounded-xl text-center font-semibold text-sm text-pink-300">Mediafire</a>`; tienePc = true; }
                if (juego.pc.drive) { gridPc.innerHTML += `<a href="${juego.pc.drive}" target="_blank" class="glass glass-hover p-2.5 rounded-xl text-center font-semibold text-sm text-blue-300">Drive</a>`; tienePc = true; }
            }
            seccionPc.style.display = tienePc ? 'block' : 'none';

            // Generar botones de Android
            const gridAndroid = document.getElementById('gridAndroid');
            const seccionAndroid = document.getElementById('seccionAndroid');
            gridAndroid.innerHTML = '';
            let tieneAndroid = false;

            if (juego.android) {
                if (juego.android.mega) { gridAndroid.innerHTML += `<a href="${juego.android.mega}" target="_blank" class="glass glass-hover p-2.5 rounded-xl text-center font-semibold text-sm text-purple-300">Mega</a>`; tieneAndroid = true; }
                if (juego.android.mediafire) { gridAndroid.innerHTML += `<a href="${juego.android.mediafire}" target="_blank" class="glass glass-hover p-2.5 rounded-xl text-center font-semibold text-sm text-pink-300">Mediafire</a>`; tieneAndroid = true; }
                if (juego.android.drive) { gridAndroid.innerHTML += `<a href="${juego.android.drive}" target="_blank" class="glass glass-hover p-2.5 rounded-xl text-center font-semibold text-sm text-blue-300">Drive</a>`; tieneAndroid = true; }
            }
            seccionAndroid.style.display = tieneAndroid ? 'block' : 'none';

            document.getElementById('downloadModal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('downloadModal').classList.add('hidden');
        }
    </script>
</body>
</html>